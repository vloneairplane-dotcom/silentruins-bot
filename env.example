# ── اجباری ─────────────────────────────────────────────
# توکن ربات از @BotFather — ⚠️ هیچ‌وقت توکن واقعی رو تو ریپو نذار
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# آیدی عددی ادمین(ها) با کاما — از @userinfobot یا /id به ربات
ADMIN_IDS=123456789

# چنل: پابلیک با @ یا پرایوت با آیدی عددی -100...
CHANNEL=@yourchannel

# ── ظاهر پست‌ها ─────────────────────────────────────────
# متن‌های پشتیبان قدیمی (دلخواه، می‌تونی حذفشون کنی):
# ADMIN_USER_ID=123456789
# CHANNEL_ID=@yourchannel

# پست‌ها عکس Pexels داشته باشن؟ (پیش‌فرض: روشن)
SEND_PHOTOS=true

# اسم عکاس ته کپشن عکس بیاد؟ (پیش‌فرض: خاموش — زیر عکس فقط متن مرتبطه)
PHOTO_CREDIT=false

# کلید Pexels از pexels.com/api — فقط اگه SEND_PHOTOS=true لازمه
PEXELS_API_KEY=

# ── زمان‌بندی ──────────────────────────────────────────
TIMEZONE=Asia/Tehran
POST_TIMES=10:00,16:00,22:00,02:00
QUALITY_THRESHOLD=82
MAX_CANDIDATES=10
MUSIC_COOLDOWN_POSTS=8

# ── دروازه کیفیت ──────────────────────────────────────
# بعد از این تعداد ردِ پیاپی، به ادمین پیام میاد:
GATE_MAX_REJECTIONS=2
# کف اضطراری: اگه بهترین گزینه از این بالاتر بود، بعد از ردهای پیاپی منتشر می‌شه (خاموش: جاهای خالی / 0 = همیشه منتشر شه)
GATE_EMERGENCY_FLOOR=70

# ── کپشن ─────────────────────────────────────────────
# ایموجی مرتبط با موود آخر کپشن؟ (پیش‌فرض: روشن)
CAPTION_EMOJI=true

# یا هر X ساعت (به‌جای ساعت‌های ثابت)
# POST_INTERVAL_HOURS=3

# ── دیتای دائمی ────────────────────────────────────────
# روی Railway: Volume با Mount Path=/data بساز و اینو فعال کن
# DATA_DIR=/data

# فقط بعضی هاست‌ها (مثل Render) ستش می‌کنن
PORT=10000
