# توکن ربات که از @BotFather می‌گیری
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# آیدی عددی خودت (نه یوزرنیم) — فقط این آیدی اجازه‌ی دستور دادن به ربات رو داره
# با فرستادن /start به @userinfobot می‌تونی بگیریش
ADMIN_USER_ID=123456789

# آیدی/یوزرنیم کانال. اگه کانال پابلیکه همینجوری با @ بنویس.
# اگه کانال پرایوته، باید آیدی عددی کانال رو بذاری (با - شروع میشه، مثل -1001234567890)
CHANNEL_ID=@songsandscars

# از unsplash.com/developers می‌گیری (ثبت یه اپلیکیشن رایگان)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# منطقه زمانی برای زمان‌بندی پست‌ها
TIMEZONE=Asia/Baku

# ساعت‌های پست عکس، با کاما جدا کن (فرمت 24 ساعته HH:MM)
PHOTO_TIMES=10:00,22:00

# ساعت‌های پست موزیک
MUSIC_TIMES=16:00

# فقط روی Render لازمه، خودش ست میشه؛ برای اجرای لوکال نیازی نیست بهش دست بزنی
PORT=10000
