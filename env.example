# توکن ربات که از @BotFather می‌گیری (دستور /newbot)
# ⚠️ هیچ‌وقت توکن واقعی رو اینجا یا تو ریپو نذار — فقط تو .env محلی یا تنظیمات هاست
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# آیدی عددی خودت — میتونی چندتا با کاما جدا کنی
# با فرستادن /id به ربات یا @userinfobot میتونی بگیریش
ADMIN_IDS=123456789

# یا تکی (برای سازگاری با نسخه قدیمی)
ADMIN_USER_ID=123456789

# آیدی/یوزرنیم کانال. اگه پابلیکه با @ بنویس، اگه پرایوته آیدی عددی -100...
CHANNEL=@yourchannel
# برای سازگاری قدیمی
CHANNEL_ID=@yourchannel

# از pexels.com/api می‌گیری — رایگان
PEXELS_API_KEY=your_pexels_api_key

# منطقه زمانی
TIMEZONE=Asia/Tehran

# زمان‌های پست خودکار (عکس دپ + متن + آهنگ) — فرمت 24 ساعته
POST_TIMES=10:00,16:00,22:00,02:00

# یا اگه بخوای هر X ساعت پست بذاره (به جای زمان ثابت)
# POST_INTERVAL_HOURS=3

# ساعت‌های جدا برای موزیک (اختیاری، قدیمی)
# MUSIC_TIMES=16:00

# فقط روی Render لازمه، خودش ست میشه
PORT=10000

# مسیر ذخیره‌ی دائمی دیتا (کتابخونه آهنگ + وضعیت).
# روی Railway: یه Volume با Mount Path=/data بساز و اینو بازش کن
# DATA_DIR=/data
